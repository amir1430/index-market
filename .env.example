# Copy to .env; docker compose reads it automatically.

# Host ports
PANEL_PORT=3000      # React panel (proxies /api to backend)
QUESTDB_PORT=9010    # QuestDB web console + REST: never expose publicly

# Markets, BASE/QUOTE, streamed from Binance, OKX and Bybit
MARKETS=BTC/USDT,ETH/USDT

# Index
INDEX_EVERY=250ms     # one index tick per market this often
INDEX_MAX_AGE=5s      # an exchange with no tick for this long leaves the index
INDEX_MIN_SOURCES=2   # fewer fresh exchanges = tick published with stale=1

# Valkey (the existing Coolify one): stream index:<market>, e.g. index:BTC/USDT
# Empty = not published. rediss:// for TLS.
# VALKEY_URL=redis://user:password@valkey-host:6379/0
VALKEY_MAXLEN=14400   # entries kept per stream (approx): 1 h at 250ms

# Only for running the backend outside compose (go run .)
# QUESTDB_URL=http://localhost:9010
# ADDR=:8080
