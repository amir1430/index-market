# Copy to .env; docker compose reads it automatically.

# No host ports: Coolify's proxy reaches the panel (frontend, port 80) by its domain.
# QuestDB console: ssh -L 9000:<questdb-container>:9000 <server>

# Markets, BASE/QUOTE, streamed from Binance, OKX, Bybit and KuCoin
MARKETS=BTC/USDT,ETH/USDT

# Index
INDEX_EVERY=250ms     # one index tick per market this often
INDEX_MAX_AGE=5s      # an exchange with no tick for this long leaves the index
INDEX_MIN_SOURCES=2   # fewer counted exchanges = tick published with stale=1 (1..4)
# Index = volume-weighted mean of the counted exchanges' last trades.
INDEX_VOLUME_HALFLIFE=15m  # an exchange's weight = its quote volume, decayed with this half-life
INDEX_MAX_DEVIATION=0.005  # a price further than this from the median (0.5%) is not counted
INDEX_MAX_WEIGHT=0.5       # no exchange counts for more than this share (the excess goes to the others)

# Valkey (the existing Coolify one): stream index:<market>, e.g. index:BTC/USDT
# Empty = not published. rediss:// for TLS.
# VALKEY_URL=redis://user:password@valkey-host:6379/0
VALKEY_MAXLEN=14400   # entries kept per stream (approx): 1 h at 250ms

# Only for running the backend outside compose (go run .)
# QUESTDB_URL=http://localhost:9010
# ADDR=:8080
